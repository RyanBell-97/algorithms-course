{
  "name": "algorithms-course",
  "version": "1.0.0",
  "description": "A free, interactive university course in algorithms and data structures.",
  "license": "MIT AND CC-BY-4.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:github": "ng build --base-href /algorithms-course/",
    "watch": "ng build --watch --configuration development",
    "check:content": "node scripts/check-course.mjs",
    "test": "npm run check:content",
    "verify": "npm run check:content && npm run build"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.20",
    "@angular/compiler": "^21.2.20",
    "@angular/core": "^21.2.20",
    "@angular/forms": "^21.2.20",
    "@angular/platform-browser": "^21.2.20",
    "@angular/router": "^21.2.20",
    "katex": "^0.16.45",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.21",
    "@angular/cli": "^21.2.21",
    "@angular/compiler-cli": "^21.2.20",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "less": "4.9.0",
    "uuid": "11.1.1",
    "webpack-dev-server": "6.0.0"
  }
}
